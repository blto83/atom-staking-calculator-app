{
  "buildCommand": "npm run build:prerender",
  "trailingSlash": false,
  "headers": [
    { "source": "/dashboard", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/rewards", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/transactions", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/settings", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "atom-staking-calculator-app.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
